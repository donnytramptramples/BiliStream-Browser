FROM node:24-slim AS base

RUN corepack enable && corepack prepare pnpm@10.26.1 --activate

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json tsconfig.json ./

COPY lib/ ./lib/
COPY artifacts/bilibili-browser/ ./artifacts/bilibili-browser/

RUN pnpm install --frozen-lockfile

ARG BASE_PATH=/
ENV BASE_PATH=${BASE_PATH}
ENV PORT=8080

RUN pnpm --filter @workspace/bilibili-browser run build

FROM nginx:alpine AS runtime

COPY --from=base /workspace/artifacts/bilibili-browser/dist/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
